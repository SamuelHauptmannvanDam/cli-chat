{
  "name": "cli-chat-mcp",
  "version": "0.6.1",
  "type": "module",
  "description": "Headless cross-CLI messenger for coding agents (MCP)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelHauptmannvanDam/cli-chat.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelHauptmannvanDam/cli-chat/issues"
  },
  "homepage": "https://github.com/SamuelHauptmannvanDam/cli-chat#readme",
  "bin": {
    "cli-chat": "dist/server-net.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "prepublishOnly": "npm run typecheck && node build.mjs",
    "test": "node --test \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:e2e": "node test/e2e/live-net.ts",
    "test:mcp": "node test/e2e/live-net-mcp.ts",
    "test:push": "node test/e2e/live-push.ts",
    "init": "node src/init-identity.ts",
    "install-clis": "node src/install.ts",
    "add-contact": "node src/add-contact.ts",
    "server": "node src/server-net.ts",
    "deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "hono": "^4.12.25",
    "libsodium-wrappers": "^0.8.4",
    "node-sqlite3-wasm": "^0.8.58",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
