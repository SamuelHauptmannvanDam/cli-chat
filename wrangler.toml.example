# Cloudflare Workers + D1 deploy config for the hosted mailbox (PLAN.md §7).
# Deploy path (not part of the local test suite):
#   1. npx wrangler d1 create cli-chat
#      → copy the database_id into [[d1_databases]] below.
#   2. npx wrangler d1 execute cli-chat --remote --file server-mailbox/schema.sql
#   3. npx wrangler deploy
# Point the client at the deployed URL via MESSENGER_MAILBOX_URL.
#
# UPGRADING AN EXISTING D1 (admission control, v0.4.7+): schema.sql is written
# for a FRESH database — re-running it on a DB created before `received_at`
# existed fails at `idx_admission` ("no such column: received_at"), because
# `CREATE TABLE IF NOT EXISTS messages` is a no-op on the existing table. D1 has
# no `ADD COLUMN IF NOT EXISTS`, so there's no purely-idempotent SQL fix. Since
# there are no users yet, the clean path is to RECREATE the DB:
#   npx wrangler d1 execute cli-chat --remote --command \
#     "DROP TABLE IF EXISTS messages; DROP TABLE IF EXISTS known; DROP TABLE IF EXISTS handles"
#   npx wrangler d1 execute cli-chat --remote --file server-mailbox/schema.sql
# To PRESERVE existing mail instead, add the column first, then apply schema.sql:
#   npx wrangler d1 execute cli-chat --remote --command \
#     "ALTER TABLE messages ADD COLUMN received_at INTEGER"
# (The node/dev driver self-heals this automatically; only D1 needs the step.)

# Worker name = first segment of the URL: <name>.<account-subdomain>.workers.dev
# (the D1 database below keeps its own name, "cli-chat", and its data.)
# Pick your own; this becomes the public URL you point clients at via
# MESSENGER_MAILBOX_URL.
name = "<your-worker-name>"
main = "server-mailbox/worker.ts"
compatibility_date = "2026-01-01"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "cli-chat"
# Run `npx wrangler d1 create cli-chat` and paste the printed id here.
database_id = "<your-d1-database-id>"

# Push delivery (PUSH.md): one Inbox Durable Object per recipient holds their
# hibernatable WebSockets; POST /messages wakes them. No persistent DO storage
# is used (sockets only), but new DO classes still require a migration entry.
[[durable_objects.bindings]]
name = "INBOX"
class_name = "Inbox"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Inbox"]

# Edge rate limiters (anti-spam, PLAN open Q#7). Cloudflare's built-in sliding
# window — keyed by an arbitrary string we pass (client IP, or sender pubkey).
# `period` must be 10 or 60 (seconds). These are the coarse outer wall; the
# per-recipient / per-sender admission caps in app.ts are the real spam ceiling.
# app.ts fails OPEN when a binding is absent, so local/Node runs are unaffected.
#   RESOLVE_LIMITER  — caps directory harvesting (handle → keys) per IP. /resolve
#                      also requires a signed request (only real accounts resolve),
#                      so this low cap is defence-in-depth against an account
#                      holder walking the 6-char handle space. A human resolves a
#                      handful of handles ever, so 20/min is generous for them and
#                      brutal for a scraper.
#   POST_IP_LIMITER  — caps the raw POST /messages flood per IP (pre-crypto).
#   POST_KEY_LIMITER — caps one verified sender's send rate.
[[unsafe.bindings]]
name = "RESOLVE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 20, period = 60 }

[[unsafe.bindings]]
name = "POST_IP_LIMITER"
type = "ratelimit"
namespace_id = "1002"
simple = { limit = 120, period = 60 }

[[unsafe.bindings]]
name = "POST_KEY_LIMITER"
type = "ratelimit"
namespace_id = "1003"
simple = { limit = 60, period = 60 }

# Cron triggers (worker.ts scheduled() branches on the cron string — keep in
# step with DAILY_CRON / HOURLY_CRON there):
#   "0 3 * * *" — daily retention: prune read mail after a week and anything
#                 older than a month, plus expired magic-link tokens/sessions.
#   "0 * * * *" — hourly waiting-mail sweep (NOTIFY-EMAIL.md): email accounts
#                 whose mail has sat unfetched for 24h, once per away-stretch.
[triggers]
crons = ["0 3 * * *", "0 * * * *"]

# ----------------------------------------------------------------------------
# Account layer (AUTH-SYNC.md): optional, paid online account for multi-device
# login + contacts/tags sync. ALL optional — a mailbox-only deploy omits them and
# the /auth + /vault routes simply 503 until they're set. Add the schema with:
#   npx wrangler d1 execute cli-chat --remote --file server-mailbox/schema.sql
# (the four new tables use CREATE TABLE IF NOT EXISTS, so it's safe to re-run on a
# DB that already has the mailbox tables — unlike the messages upgrade note above).
#
# Non-secret vars go in [vars]; secrets go via `wrangler secret put <NAME>`:
#   wrangler secret put RESEND_API_KEY        # outbound email for magic links
#   wrangler secret put STRIPE_WEBHOOK_SECRET # verify the one-time-unlock webhook
#
# [vars]
# EMAIL_FROM   = "cli-chat <login@your-domain.com>"  # a verified Resend sender
# INVITE_EMAIL_FROM = "cli-chat <invite-once@your-domain.com>"  # once-ever invites (EMAIL-SEND.md)
# NOTIFY_EMAIL_FROM = "cli-chat <notify@your-domain.com>"  # waiting-mail emails (NOTIFY-EMAIL.md);
#                                                          # falls back to INVITE_EMAIL_FROM when unset
# APP_BASE_URL = "https://<your-worker-name>.<subdomain>.workers.dev"  # magic-link origin
# CHECKOUT_URL = "https://buy.stripe.com/xxx"          # one-time-unlock Payment Link
#
# Point the Stripe Payment Link's webhook at  <APP_BASE_URL>/billing/webhook  and
# subscribe to `checkout.session.completed`. The account id rides as
# client_reference_id (added by POST /billing/checkout), so the webhook flips the
# right account's `paid` flag.
